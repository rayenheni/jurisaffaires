    cards = "\n".join(member_card(m) for m in TEAM)
    body = f"""
<section class="page-hero grain">
  <div class="rule-grid" aria-hidden="true"></div>
  <div class="container">
    <div class="page-hero__inner page-hero__inner--split">
      <div>
