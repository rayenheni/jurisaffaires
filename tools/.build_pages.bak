def slugify(text):
    text = text.replace("&amp;", " et ").replace("&", " et ")
    text = unicodedata.normalize("NFD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


